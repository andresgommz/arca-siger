# Copiar a .env.local (local) o a Settings > Environment Variables (Vercel).
# El alias del esquema se ve en APEX: SQL Workshop > RESTful Services.
ORDS_BASE_URL=https://oracleapex.com/ords/<alias_del_esquema>/arca/
ORDS_OAUTH_TOKEN_URL=https://oracleapex.com/ords/<alias_del_esquema>/oauth/token
# Los imprime 4_ARCA_API_REST.sql con DBMS_OUTPUT.
ORDS_CLIENT_ID=
ORDS_CLIENT_SECRET=
DEMO_TIMEZONE=America/Bogota
# Clave para operaciones de escritura; vacía = sin clave.
DEMO_CLAVE=
# true en local (guarda la caché en data/cache/); false en Vercel.
CACHE_LOCAL=true
